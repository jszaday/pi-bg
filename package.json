{
  "name": "pi-bg",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Background tasks for the Pi coding agent: move long-running bash commands to the background, then check, wait for, and kill them.",
  "keywords": ["pi-package", "pi", "pi-extension", "pi-coding-agent", "bash", "background", "shell", "tasks"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jszaday/pi-bg.git"
  },
  "bugs": {
    "url": "https://github.com/jszaday/pi-bg/issues"
  },
  "homepage": "https://github.com/jszaday/pi-bg#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "main": "./src/index.ts",
  "files": ["src", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:gated": "PI_BG_GATED=1 vitest run --config test/gated/vitest.config.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
